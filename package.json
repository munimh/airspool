{
  "name": "airspool",
  "version": "0.1.2",
  "description": "Reliable Airtable writes from a backend: a rate-limited fetch client and a durable outbox that queues, merges and retries.",
  "license": "MIT",
  "author": "Hussain Munim",
  "repository": { "type": "git", "url": "git+https://github.com/munimh/airspool.git" },
  "homepage": "https://github.com/munimh/airspool#readme",
  "bugs": { "url": "https://github.com/munimh/airspool/issues" },
  "keywords": [
    "airtable",
    "airtable api",
    "rate limit",
    "outbox",
    "transactional outbox",
    "retry",
    "queue",
    "supabase",
    "postgres",
    "sqlite",
    "deno",
    "bun",
    "cloudflare-workers",
    "typescript"
  ],
  "type": "module",
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./sql/postgres.sql": "./sql/postgres.sql",
    "./sql/sqlite.sql": "./sql/sqlite.sql",
    "./package.json": "./package.json"
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "files": ["dist", "sql", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.npm.json && node scripts/fix_dts.mjs",
    "test:node": "node scripts/node_smoke.mjs",
    "prepublishOnly": "npm run build && npm run test:node"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
