{
  "name": "@munimh/airspool",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "sql/*.sql",
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "SECURITY.md"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": { "tags": ["recommended", "jsr"] }
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": ["dist/", "node_modules/", "npm/"]
  },
  "exclude": ["dist/", "node_modules/"],
  "nodeModulesDir": "none",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "postgres": "npm:postgres@^3.4.5"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read=sql,examples --allow-net=127.0.0.1,localhost",
    "check": "deno fmt --check && deno lint && deno check mod.ts && deno doc --lint mod.ts",
    "schema": "deno run --allow-write=sql scripts/write_schema.ts"
  }
}
